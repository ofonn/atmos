root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{ts,tsx,js,jsx,json,yml,yaml,toml,md}]
indent_size = 2

[*.dart]
indent_size = 2

[*.{kt,kts,gradle}]
indent_size = 4

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab
