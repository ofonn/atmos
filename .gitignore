mobile/.flutter/

# Generated / IDE
mobile/.idea/
mobile/.vscode/
mobile/*.iml

# Android specifics
mobile/android/.gradle/
mobile/android/captures/
mobile/android/.cxx/
mobile/android/build/
mobile/android/app/build/

# Local SDK paths — varies per dev machine
mobile/android/local.properties

# Release signing — keystore + passwords NEVER in git
mobile/android/key.properties
mobile/android/app/*.keystore
mobile/android/app/*.jks
mobile/android/app/upload-keystore.jks

# Firebase / Google services config (semi-secret — contains project IDs)
mobile/android/app/google-services.json
mobile/android/app/src/**/google-services.json

# iOS / desktop (not currently targeted)
mobile/ios/
mobile/macos/
mobile/linux/
mobile/windows/
mobile/web/

