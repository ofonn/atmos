# =============================================================================
# Atmos — environment variables template
# Copy to .env.local for local dev. NEVER commit the filled-in version.
# Production values live in Vercel project settings.
# =============================================================================

# --- AI (Gemini) ---
# Server-only. Get it from https://aistudio.google.com/apikey.
# Use gemini-2.5-flash. Do NOT use 2.0-flash (0 quota on the free tier).
GEMINI_API_KEY=

# --- Supabase ---
# From Supabase Dashboard → Project Settings → API.
# URL + anon key are safe to expose to the browser (NEXT_PUBLIC_).
# Service role key is SERVER-ONLY — never prefix with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Play Integrity (mobile API gating) ---
# Service account JSON (full content, one line, escaped) with role
# `roles/playintegrity.user` on the Google Cloud project linked to Play.
# See: https://developer.android.com/google/play/integrity/setup
GOOGLE_PLAY_INTEGRITY_SA_JSON=

# Android app package name — must match the APK applicationId.
ANDROID_PACKAGE_NAME=com.atmos.app

# 'strict' rejects sideloaded / unrecognized installs. Use 'lenient'
# for closed/internal testing, switch to 'strict' once on the Play Store.
PLAY_INTEGRITY_STRICTNESS=lenient

# --- Stripe (subscription billing) ---
# Server-only. From https://dashboard.stripe.com/apikeys.
# Use test keys (sk_test_...) for dev, live (sk_live_...) for prod.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public price IDs (safe to expose). Create products in Stripe Dashboard.
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=

# --- Push notifications (web push, optional) ---
# Generate with `npx web-push generate-vapid-keys`. Public key is exposed.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Site URL (used for redirect URIs, OG tags) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sentry (optional crash reporting) ---
# DSN is a public token (write-only ingest). Auth token is build-time
# only and lets withSentryConfig upload source maps.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=atmos-web
