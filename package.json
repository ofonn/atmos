{
  "name": "atmos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "next build && next start",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "check": "bash scripts/deploy-check.sh",
    "prepare": "husky || true",
    "migrate": "supabase db push",
    "migrate:dry": "supabase db push --dry-run",
    "supabase:types": "supabase gen types typescript --linked > src/lib/supabase/db.types.generated.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@types/leaflet": "^1.9.21",
    "framer-motion": "^11.18.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "14.2.21",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-swipeable": "^7.0.2",
    "stripe": "^22.1.1",
    "swr": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.21",
    "husky": "^9.1.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  }
}
